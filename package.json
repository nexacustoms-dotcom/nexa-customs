{
  "name": "nexa-customs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "chmod +x ./node_modules/.bin/vite || true",
    "build": "(node scripts/generate-sitemap.mjs; node scripts/generate-feed.mjs; node scripts/generate-local-inventory.mjs; true) && vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "sync:vercel": "node scripts/prerender.mjs --sync-vercel",
    "feeds": "node scripts/generate-sitemap.mjs && node scripts/generate-feed.mjs && node scripts/generate-local-inventory.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "puppeteer-core": "^25.9.0",
    "vite": "^5.4.2"
  }
}
